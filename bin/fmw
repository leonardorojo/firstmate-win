#!/usr/bin/env bash
set -euo pipefail
# fmw — firstmate-win: Firstmate <-> Windows repos compatibility layer.
# Runtime: WSL. Repositories and worktrees ALWAYS live on Windows (/mnt).
# Usage: fmw help

FMW_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
for _lib in common config paths safety projects worktrees windows runtime firstmate reconcile captain; do
  . "$FMW_LIB_DIR/$_lib.sh"
done
unset _lib

cmd="${1:-help}"
[ $# -gt 0 ] && shift || true
fmw_is_inside_wsl || { echo "fmw: ERROR: must run inside WSL (wslpath missing)" >&2; exit 1; }
case "$cmd" in
  doctor|config|captain|win) : ;;  # diagnostic/guide/tool commands must not create runtime state
  *) fmw_ensure_dirs ;;
esac

fmw_help() {
  cat <<'EOF'
fmw — firstmate-win: Firstmate orchestrates in WSL; repos and worktrees on Windows.

USAGE
  fmw version                      wrapper version
  fmw help                         this help
  fmw doctor [options]             static environment diagnostics (WSL/Windows)
  fmw config show [options]         effective portable configuration
  fmw captain                       validate Herdr and print the safe Pi start command
  fmw captain status [options]      read-only operational captain/watcher diagnosis
  fmw win exec --cwd <wsl-dir> [--report] [--backend direct|powershell] -- <exe> [args...]
                                      run one Windows tool with individual arguments

  fmw path to-wsl <p>              Windows path -> WSL (wslpath -u)
  fmw path to-windows <p>          WSL path -> Windows (wslpath -w)
  fmw path canonical <p>           canonicalize (realpath -m, lowercase drive)
  fmw path check <p>               validate it is under /mnt/<drive>/

  fmw project add --name N --windows-path P --worktree-root R [--profile P]
  fmw project list
  fmw project show <name>
  fmw project validate <name>

  fmw task prepare --project P --id T [--branch B]
  fmw task show <id>
  fmw task list
  fmw task status <id>
  fmw task brief <id> [--scout]         brief via fm-brief.sh (Firstmate)
  fmw task spawn <id> [--scout] [--harness X] [--model M] [--effort E]
                                         hands the worktree to fm-spawn.sh (shim)
  fmw task send <id> <message...>       steering via fm-send.sh
  fmw task open <id> --explorer|--vscode|--visual-studio
  fmw task teardown <id> [--force]     fail-closed; keeps the branch

  fmw exec powershell <script...>  native PowerShell (exact exit code)
  fmw exec cmd <command...>        native CMD (exact exit code)
  fmw build [--task <id>]          Windows build via profile (from worktree or --task)
  fmw test  [--task <id>]          Windows tests via profile
  fmw open <path> --target T       open path in explorer|vscode|visual-studio
EOF
}

# --- portable configuration and static doctor -------------------------------
fmw_doctor_line() { printf '  [%s] %s' "$1" "$2"; [ -n "${3:-}" ] && printf ': %s' "$3"; printf '\n'; }
fmw_doctor_fail() { fmw_doctor_line FAIL "$1" "${2:-}"; FMW_DOCTOR_OK=0; return 1; }
fmw_doctor_pass() { fmw_doctor_line PASS "$1" "${2:-}"; }
fmw_doctor_warn() { fmw_doctor_line WARN "$1" "${2:-}"; }
fmw_doctor_skip() { fmw_doctor_line SKIP "$1" "${2:-}"; }

fmw_doctor_path() {
  local label="$1" path="$2" require_dir="${3:-0}"
  if ! fmw_path_is_absolute_wsl "$path"; then
    fmw_doctor_fail "$label" "not an absolute WSL path; set the corresponding configuration key"
    return 1
  fi
  if [ "$require_dir" = 1 ] && [ ! -d "$path" ]; then
    fmw_doctor_fail "$label" "$path is not an existing directory"
    return 1
  fi
  fmw_doctor_pass "$label" "$path"
  return 0
}

fmw_doctor_firstmate() {
  local root="$FMW_CFG_FIRSTMATE_ROOT" script
  fmw_doctor_path "FIRSTMATE_ROOT" "$root" 1 || return
  for script in fm-spawn.sh fm-brief.sh fm-teardown.sh; do
    if [ -f "$root/bin/$script" ]; then
      fmw_doctor_pass "Firstmate $script" "$root/bin/$script"
    else
      fmw_doctor_fail "Firstmate $script" "missing; install or configure FIRSTMATE_ROOT=$root"
    fi
  done
}

fmw_doctor_treehouse() {
  local candidate="$FMW_CFG_TREEHOUSE_BIN" real shim version
  [ -n "$candidate" ] || { fmw_doctor_fail "TREEHOUSE_BIN" "not found; set TREEHOUSE_BIN to the real executable"; return; }
  [ -x "$candidate" ] || { fmw_doctor_fail "TREEHOUSE_BIN" "$candidate is not executable"; return; }
  real="$(readlink -f "$candidate" 2>/dev/null || printf '%s' "$candidate")"
  shim="$(readlink -f "$FMW_SHIMS_DIR/treehouse" 2>/dev/null || true)"
  if [ -n "$shim" ] && [ "$real" = "$shim" ]; then
    fmw_doctor_fail "real Treehouse" "$candidate resolves to the firstmate-win shim; configure the real Treehouse binary"
    return
  fi
  version="$("$real" --version 2>&1)" || { fmw_doctor_fail "real Treehouse" "$real --version failed; do not update it automatically"; return; }
  fmw_doctor_pass "real Treehouse" "$real ($version)"
}

fmw_doctor_dotnet() {
  local candidate="$FMW_CFG_WINDOWS_DOTNET" version info
  [ -n "$candidate" ] || { fmw_doctor_fail "WINDOWS_DOTNET" "dotnet.exe not found; set WINDOWS_DOTNET"; return; }
  [ -x "$candidate" ] || { fmw_doctor_fail "WINDOWS_DOTNET" "$candidate is not executable"; return; }
  version="$("$candidate" --version 2>&1)" || { fmw_doctor_fail "WINDOWS_DOTNET" "$candidate --version failed"; return; }
  info="$("$candidate" --info 2>&1)" || { fmw_doctor_fail "WINDOWS_DOTNET" "$candidate --info failed"; return; }
  case "$info" in
    *"OS Name: Windows"*|*"RID: win-"*|*"win32"*) fmw_doctor_pass "Windows dotnet.exe" "$candidate ($version)" ;;
    *) fmw_doctor_fail "Windows dotnet.exe" "$candidate did not report a Windows runtime" ;;
  esac
}

fmw_doctor_static() {
  local explicit=("$@") out pi_path herdr_path jq_path npm_path
  FMW_DOCTOR_OK=1
  fmw_config_resolve "${explicit[@]}" || { fmw_doctor_fail "portable configuration" "invalid allowlisted config; see the error above"; return 1; }
  echo "fmw doctor ($FMW_VERSION) — static WSL/Windows installation"
  echo "  config=$(fmw_config_default_file)"
  echo "  FIRSTMATE_ROOT=$FMW_CFG_FIRSTMATE_ROOT"
  echo "  FM_HOME=$FMW_CFG_FM_HOME"
  echo "  FMW_REPOS_ROOT=$FMW_CFG_REPOS_ROOT"
  echo "  FMW_WORKTREES_ROOT=$FMW_CFG_WORKTREES_ROOT"
  echo "  TREEHOUSE_BIN=$FMW_CFG_TREEHOUSE_BIN"
  echo "  WINDOWS_DOTNET=$FMW_CFG_WINDOWS_DOTNET"
  echo "  WINDOWS_MSBUILD=${FMW_CFG_WINDOWS_MSBUILD:-<optional>}
"

  fmw_is_inside_wsl && fmw_doctor_pass "WSL runtime" "wslpath present" || fmw_doctor_fail "WSL runtime" "wslpath is missing"
  command -v git >/dev/null 2>&1 && fmw_doctor_pass "WSL Git" "$(command -v git)" || fmw_doctor_fail "WSL Git" "git is missing"
  command -v wslpath >/dev/null 2>&1 && fmw_doctor_pass "wslpath" "$(command -v wslpath)" || true
  command -v jq >/dev/null 2>&1 && fmw_doctor_pass "jq" "$(command -v jq)" || fmw_doctor_fail "jq" "install jq in WSL"
  if herdr_path="$(command -v herdr 2>/dev/null)" && out="$(herdr --version 2>&1)"; then
    fmw_doctor_pass "Herdr installed" "$herdr_path ($out)"
  else
    fmw_doctor_fail "Herdr installed" "herdr is missing or --version failed"
  fi
  if pi_path="$(command -v pi 2>/dev/null)" && out="$(pi --version 2>&1)"; then
    fmw_doctor_pass "Pi installed" "$pi_path ($out)"
  else
    fmw_doctor_fail "Pi installed" "pi is missing or --version failed"
  fi
  if out="$(fmw_runtime_node_linux 2>&1)"; then
    fmw_doctor_pass "Linux Node" "$out"
  else
    fmw_doctor_fail "Linux Node" "$out"
  fi
  if out="$(fmw_runtime_pi_linux 2>&1)"; then
    fmw_doctor_pass "Linux Pi" "$out"
  else
    fmw_doctor_fail "Linux Pi" "$out"
  fi
  command -v powershell.exe >/dev/null 2>&1 && fmw_doctor_pass "Windows interop: PowerShell" "$(command -v powershell.exe)" || fmw_doctor_fail "Windows interop: PowerShell" "powershell.exe is missing"
  command -v cmd.exe >/dev/null 2>&1 && fmw_doctor_pass "Windows interop: CMD" "$(command -v cmd.exe)" || fmw_doctor_fail "Windows interop: CMD" "cmd.exe is missing"
  npm_path="$(command -v npm 2>/dev/null || true)"
  [ -n "$npm_path" ] && fmw_doctor_pass "npm PATH" "$npm_path" || fmw_doctor_warn "npm PATH" "npm is not required for every installed runtime"

  fmw_doctor_firstmate
  fmw_doctor_treehouse
  fmw_doctor_dotnet
  if [ -n "$FMW_CFG_WINDOWS_MSBUILD" ]; then
    [ -x "$FMW_CFG_WINDOWS_MSBUILD" ] && fmw_doctor_pass "optional MSBuild" "$FMW_CFG_WINDOWS_MSBUILD" || fmw_doctor_fail "optional MSBuild" "$FMW_CFG_WINDOWS_MSBUILD is not executable"
  else
    fmw_doctor_warn "optional MSBuild" "not configured; dotnet.exe may be sufficient"
  fi

  fmw_doctor_path "FM_HOME" "$FMW_CFG_FM_HOME" 0
  case "$FMW_CFG_FM_HOME" in /tmp/*|/var/tmp/*) fmw_doctor_fail "FM_HOME safety" "$FMW_CFG_FM_HOME looks temporary; configure a durable home" ;; esac
  if [ -n "$FMW_CFG_REPOS_ROOT" ]; then
    fmw_path_is_windows_mounted "$FMW_CFG_REPOS_ROOT" && [ -d "$FMW_CFG_REPOS_ROOT" ] \
      && fmw_doctor_pass "FMW_REPOS_ROOT" "$FMW_CFG_REPOS_ROOT" \
      || fmw_doctor_fail "FMW_REPOS_ROOT" "$FMW_CFG_REPOS_ROOT must be an accessible /mnt/<drive> directory"
  else
    fmw_doctor_fail "FMW_REPOS_ROOT" "ambiguous or undetected Windows mount; configure FMW_REPOS_ROOT"
  fi
  if [ -n "$FMW_CFG_WORKTREES_ROOT" ] && fmw_path_is_windows_mounted "$FMW_CFG_WORKTREES_ROOT" \
      && fmw_path_reject_native_wsl "$FMW_CFG_WORKTREES_ROOT" >/dev/null 2>&1 \
      && fmw_path_parent_writable "$FMW_CFG_WORKTREES_ROOT"; then
    fmw_doctor_pass "FMW_WORKTREES_ROOT" "$FMW_CFG_WORKTREES_ROOT (no worktree created)"
  else
    fmw_doctor_fail "FMW_WORKTREES_ROOT" "$FMW_CFG_WORKTREES_ROOT must be a writable or creatable /mnt/<drive> root"
  fi
  if [ "$FMW_DOCTOR_OK" = 1 ]; then
    echo "  -> static installation OK (captain/watcher/tasks are not required)"
    return 0
  fi
  echo "  -> static installation has failures"
  return 1
}

fmw_doctor() { fmw_doctor_static "$@"; }

fmw_config_show() {
  fmw_config_resolve "$@" || return
  printf 'config=%s\nFIRSTMATE_ROOT=%s\nFM_HOME=%s\nFMW_REPOS_ROOT=%s\nFMW_WORKTREES_ROOT=%s\nTREEHOUSE_BIN=%s\nWINDOWS_DOTNET=%s\nWINDOWS_MSBUILD=%s\n' \
    "$(fmw_config_default_file)" "$FMW_CFG_FIRSTMATE_ROOT" "$FMW_CFG_FM_HOME" \
    "$FMW_CFG_REPOS_ROOT" "$FMW_CFG_WORKTREES_ROOT" "$FMW_CFG_TREEHOUSE_BIN" \
    "$FMW_CFG_WINDOWS_DOTNET" "$FMW_CFG_WINDOWS_MSBUILD"
}

# --- path ---
fmw_cli_path() {
  local sub="${1:-}" p
  [ -n "$sub" ] || fmw_die "usage: fmw path <to-wsl|to-windows|canonical|check> <path>"
  shift || true
  p="${1:-}"
  [ -n "$p" ] || fmw_die "missing path"
  case "$sub" in
    to-wsl)     fmw_path_to_wsl "$p" ;;
    to-windows) fmw_path_to_windows "$p" ;;
    canonical)  fmw_path_canonical "$p" ;;
    check)
      if fmw_path_is_windows_mounted "$p"; then
        echo "OK: $(fmw_path_canonical "$p") (under /mnt/<drive>/)"
      else
        fmw_die "does not resolve under /mnt/<drive>/: $(fmw_path_canonical "$p")"
      fi ;;
    *) fmw_die "unknown subcommand: $sub";;
  esac
}

# --- config ---
fmw_cli_config() {
  local sub="${1:-show}"
  shift || true
  case "$sub" in
    show) fmw_config_show "$@" ;;
    *) fmw_die "unknown config command: $sub (use: fmw config show)" ;;
  esac
}

# --- project ---
fmw_cli_project() {
  local sub="${1:-}"
  [ -n "$sub" ] || fmw_die "usage: fmw project <add|list|show|validate>"
  shift || true
  case "$sub" in
    add)      fmw_project_add "$@" ;;
    list)     fmw_project_list ;;
    show)     [ $# -ge 1 ] || fmw_die "usage: fmw project show <name>"; fmw_project_show "$1" ;;
    validate) [ $# -ge 1 ] || fmw_die "usage: fmw project validate <name>"; fmw_project_validate "$1" ;;
    *) fmw_die "unknown subcommand: $sub";;
  esac
}

# --- task ---
fmw_cli_task() {
  local sub="${1:-}"
  [ -n "$sub" ] || fmw_die "usage: fmw task <prepare|show|list|status|abandon|teardown>"
  shift || true
  case "$sub" in
    prepare)  fmw_task_prepare "$@" ;;
    show)     [ $# -ge 1 ] || fmw_die "usage: fmw task show <id>"; fmw_task_show "$1" ;;
    list)     fmw_task_list ;;
    status)   [ $# -ge 1 ] || fmw_die "usage: fmw task status <id>"; fmw_task_status "$1" ;;
    teardown) fmw_task_teardown "$@" ;;
    abandon)  fmw_task_abandon "$@" ;;
    open)     fmw_cli_task_open "$@" ;;
    brief)    fmw_task_brief "$@" ;;
    spawn)    fmw_task_spawn "$@" ;;
    send)     fmw_task_send "$@" ;;
    *) fmw_die "unknown subcommand: $sub";;
  esac
}

# fmw task open <id> --explorer|--vscode|--visual-studio
fmw_cli_task_open() {
  local id="${1:-}" target=""
  [ -n "$id" ] || fmw_die "usage: fmw task open <id> --explorer|--vscode|--visual-studio"
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --explorer)       target="explorer"; shift ;;
      --vscode)         target="vscode"; shift ;;
      --visual-studio)  target="visual-studio"; shift ;;
      *) fmw_die "unknown argument: $1";;
    esac
  done
  [ -n "$target" ] || fmw_die "missing target: --explorer|--vscode|--visual-studio"
  fmw_task_load "$id" || return 1
  [ -d "$WORKTREE_WSL_PATH" ] || fmw_die "worktree does not exist: $WORKTREE_WSL_PATH"
  if [ "$target" = "visual-studio" ]; then
    # open the project solution in VS (via profile) instead of the directory
    fmw_profile_load "$PROJECT_NAME" "$id" >/dev/null 2>&1 && { fmw_profile_open visual-studio; return $?; }
  fi
  fmw_open "$WORKTREE_WSL_PATH" "$target"
}

# --- Windows tool execution ---
fmw_cli_win() {
  local sub="${1:-}" cwd="${PWD}" backend=direct report=0 separator=0 executable
  local -a tool_args=() config_args=()
  [ -n "$sub" ] || fmw_die "usage: fmw win exec [--cwd <absolute-wsl-dir>] [--report] -- <executable> [args...]"
  shift
  [ "$sub" = exec ] || fmw_die "unknown win command: $sub (use: fmw win exec)"
  while [ $# -gt 0 ]; do
    if [ "$separator" = 1 ]; then
      tool_args+=("$1"); shift; continue
    fi
    case "$1" in
      --) separator=1; shift ;;
      --cwd) [ $# -ge 2 ] || fmw_die "--cwd requires an absolute WSL directory"; cwd="$2"; shift 2 ;;
      --backend) [ $# -ge 2 ] || fmw_die "--backend requires direct or powershell"; backend="$2"; shift 2 ;;
      --report) report=1; shift ;;
      --config|--windows-dotnet|--windows-msbuild)
        [ $# -ge 2 ] || fmw_die "$1 requires a value"
        config_args+=("$1" "$2"); shift 2 ;;
      -*) fmw_die "unknown win exec option: $1 (put executable options after --)" ;;
      *) fmw_die "win exec requires -- before the executable" ;;
    esac
  done
  [ "$separator" = 1 ] && [ "${#tool_args[@]}" -gt 0 ] || fmw_die "win exec requires -- <executable> [args...]"
  executable="${tool_args[0]}"
  tool_args=("${tool_args[@]:1}")
  case "$backend" in direct|powershell) ;; *) fmw_die "unknown backend: $backend (direct|powershell)" ;; esac
  fmw_config_resolve "${config_args[@]}" || return 1
  fmw_win_validate_cwd "$cwd" || return 1
  fmw_win_exec "$cwd" "$backend" "$report" "$executable" "${tool_args[@]}"
}

# --- exec ---
fmw_cli_exec() {
  local sub="${1:-}"
  [ -n "$sub" ] || fmw_die "usage: fmw exec <powershell|cmd> <command...>"
  shift || true
  case "$sub" in
    powershell) fmw_exec_powershell "$@" ;;
    cmd)        fmw_exec_cmd "$@" ;;
    *) fmw_die "unknown subcommand: $sub";;
  esac
}

# --- build/test/open ---
fmw_cli_build() { fmw_build "$@"; }
fmw_cli_test()  { fmw_test "$@"; }
fmw_cli_open() {
  local path="" target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --target) target="$2"; shift 2 ;;
      -*) fmw_die "unknown argument: $1";;
      *) [ -z "$path" ] && path="$1" || fmw_die "too many arguments"; shift ;;
    esac
  done
  [ -n "$path" ] && [ -n "$target" ] || fmw_die "usage: fmw open <path> --target <explorer|vscode|visual-studio>"
  fmw_open "$path" "$target"
}

# --- dispatch ---
if [ "${FMW_NO_DISPATCH:-0}" = 1 ]; then
  return 0 2>/dev/null || exit 0
fi
case "$cmd" in
  version)          echo "fmw $FMW_VERSION" ;;
  help|--help|-h)   fmw_help ;;
  doctor)           fmw_doctor "$@" ;;
  config)           fmw_cli_config "$@" ;;
  captain)          fmw_captain "$@" ;;
  win)              fmw_cli_win "$@" ;;
  path)             fmw_cli_path "$@" ;;
  project)          fmw_cli_project "$@" ;;
  task)             fmw_cli_task "$@" ;;
  exec)             fmw_cli_exec "$@" ;;
  build)            fmw_cli_build "$@" ;;
  test)             fmw_cli_test "$@" ;;
  open)             fmw_cli_open "$@" ;;
  *) fmw_die "unknown command: $cmd (fmw help)";;
esac
